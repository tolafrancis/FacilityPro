# FacilityPro edge gateway
# Project URL and its publishable (anon) key: Supabase → Project Settings → API Keys.
FACILITYPRO_URL=https://<project-ref>.supabase.co
FACILITYPRO_API_KEY=
# This gateway's key: FacilityPro → Devices → Gateways → (gateway) → key.
GATEWAY_KEY=

# Keep unsent readings across restarts (recommended).
BUFFER_FILE=/data/buffer.json
# BUFFER_MAX=50000
# CONFIG_SYNC_MS=60000
# COMMAND_POLL_MS=5000

# Local MQTT broker for devices with protocol "mqtt" (optional).
# MQTT_URL=mqtt://192.168.1.10:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
