// The live demo (demo.facilitypro.tech): a separate Worker that only serves
// the demo build. Deploy with `npx wrangler deploy -c wrangler.demo.jsonc`.
//
// Never deploy the demo with the default wrangler.jsonc: that file attaches
// facilitypro.tech and www.facilitypro.tech, and a second Worker deploying it
// takes the live site's domains.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demo-facilitypro",
  "compatibility_date": "2025-09-01",
  // No Worker script: the Zalo webhook forwarder belongs to production only.
  "routes": [
    { "pattern": "demo.facilitypro.tech", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
