# Copy to .env.local and fill in. Everything prefixed VITE_ is compiled into
# the public web bundle: never put a secret key here (service_role, OpenAI,
# Resend, Twilio…). Those are Edge Function secrets (`supabase secrets set`).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
# The app's public address, used in printed asset QR codes
VITE_PUBLIC_APP_URL=https://app.yourdomain.com

# Optional: Cloudflare Turnstile CAPTCHA on the public report form, sign-in and sign-up
# (set for production in .env.production)
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFC3Q7Rai1GiY9zd

# Optional: web push (public half of the VAPID keypair)
# VITE_VAPID_PUBLIC_KEY=

# Optional: error tracking (Sentry). Loaded only when set.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# VITE_SENTRY_ENVIRONMENT=production
