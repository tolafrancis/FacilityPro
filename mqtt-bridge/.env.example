# FacilitySpace MQTT bridge — environment
# Copy to .env (or export these in your host) before `npm start`.

# Your Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=

# SERVICE ROLE key (Project Settings → API → service_role). Bypasses RLS so the
# worker can read every org's enabled connections and call fp_device_ingest.
# Treat as a secret — never ship it to the browser/app.
SUPABASE_SERVICE_ROLE_KEY=

# Optional tuning
# SYNC_INTERVAL_MS=15000
# HEARTBEAT_MS=60000
